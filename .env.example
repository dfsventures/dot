# Copy to .dot.env and fill in. Never commit the real file.

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Your numeric Telegram user ID (the bot ignores everyone else).
# Get it by messaging @userinfobot on Telegram.
YOUR_TELEGRAM_USER_ID=

# Granola API token (requires Enterprise plan for the public API)
GRANOLA_TOKEN=

# Dropbox app credentials from the App Console → Settings tab,
# then run dropbox_auth.py to obtain the access/refresh tokens.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_TOKEN=
DROPBOX_REFRESH_TOKEN=

# Password for the web conversation viewer (web.py). Pick something strong.
WEB_SECRET=
