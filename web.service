[Unit]
Description=Dot web viewer
After=network.target tailscaled.service

[Service]
Type=simple
User=joey
WorkingDirectory=/home/joey/dot
ExecStart=/home/joey/dot/venv/bin/uvicorn web:app --host 100.81.39.79 --port 8080
Restart=always
RestartSec=5
EnvironmentFile=/home/joey/dot/.dot.env

[Install]
WantedBy=multi-user.target
